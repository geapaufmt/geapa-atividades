function atividades_seedConfigPadrao_() {
  var sheet = atividades_getConfigSheet_();
  var existing = GEAPA_CORE.coreReadSheetRecords(sheet, { headerRow: 1 })
    .filter(function(row) {
      return Object.keys(row).some(function(key) {
        return String(row[key] || '').trim() !== '';
      });
    });

  if (existing.length) {
    return {
      ok: true,
      seeded: false,
      reason: 'config_not_empty',
      existingRows: existing.length
    };
  }

  var rows = atividades_buildDefaultConfigRows_();
  rows.forEach(function(row) {
    GEAPA_CORE.coreAppendObjectByHeaders(sheet, row, { headerRow: 1 });
  });

  atividades_logEvento_({
    TIPO_EVENTO_LOG: 'SEED_CONFIG_PADRAO',
    STATUS: 'OK',
    ACAO_EXECUTADA: 'Semear Atividades_Config',
    RESULTADO: 'Linhas inseridas: ' + rows.length,
    OBSERVACOES: 'Seed padrao aplicado apenas porque a aba estava vazia.'
  });

  return {
    ok: true,
    seeded: true,
    rowCount: rows.length
  };
}

function atividades_garantirConfigPadrao_() {
  return atividades_seedConfigPadrao_();
}
